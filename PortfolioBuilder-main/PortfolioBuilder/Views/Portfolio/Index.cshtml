@model Portfolio
@{
    var webProjects = Model.Projects.Where(p => p.Platform == ProjectPlatform.Web).ToList();
    var mobileProjects = Model.Projects.Where(p => p.Platform == ProjectPlatform.Mobile).ToList();
}

<section class="hero">
    <div class="wrap hero__inner">
        <div class="hero__text">
            <p class="hero__role">@Model.Title</p>
            <h1 class="hero__name">@Model.FullName</h1>
            <p class="hero__intro">@Model.Intro</p>
            <div class="hero__actions">
                <a class="button button--solid" href="#projects">See my projects</a>
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <a class="button" href="mailto:@Model.Email">Email me</a>
                }
                else if (!string.IsNullOrEmpty(Model.GitHubUrl))
                {
                    <a class="button" href="@Model.GitHubUrl" target="_blank" rel="noopener"><partial name="_GitHubIcon" />GitHub profile</a>
                }
            </div>
        </div>
        <img class="hero__photo" src="@Model.Avatar" alt="Photo of @Model.FullName" width="2160" height="2160" />
    </div>
</section>

<section class="skills" aria-labelledby="skills-heading">
    <div class="wrap">
        <h2 id="skills-heading" class="section-title">What I work with</h2>
        <dl class="skills__grid">
            @foreach (var group in Model.SkillGroups)
            {
                <div class="skills__group">
                    <dt>@group.Name</dt>
                    <dd>
                        <ul class="tags tags--large">
                            @foreach (var skill in group.Skills)
                            {
                                <li>@skill</li>
                            }
                        </ul>
                    </dd>
                </div>
            }
        </dl>
    </div>
</section>

<section class="projects" id="projects" aria-labelledby="projects-heading">
    <div class="wrap">
        <h2 id="projects-heading" class="section-title">Projects</h2>

        @if (webProjects.Any())
        {
            <h3 class="projects__group">Web apps</h3>
            <div class="project-grid project-grid--web">
                @foreach (var project in webProjects)
                {
                    <partial name="_ProjectCard" model="project" />
                }
            </div>
        }

        @if (mobileProjects.Any())
        {
            <h3 class="projects__group">Mobile apps</h3>
            <div class="project-grid project-grid--mobile">
                @foreach (var project in mobileProjects)
                {
                    <partial name="_ProjectCard" model="project" />
                }
            </div>
        }
    </div>
</section>
