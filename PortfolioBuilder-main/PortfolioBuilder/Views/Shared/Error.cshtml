@model ErrorViewModel
@{
    ViewData["Title"] = Model.IsNotFound ? "Page not found" : "Something went wrong";
}

<section class="page">
    <div class="wrap error-page">
        <p class="error-page__code">@Model.StatusCode</p>
        @if (Model.IsNotFound)
        {
            <h1 class="page__title">This page doesn't exist</h1>
            <p>The link may be old or mistyped. Head back to the home page to see all projects.</p>
        }
        else
        {
            <h1 class="page__title">Something went wrong</h1>
            <p>The server couldn't load this page. Try again in a moment, or go back to the home page.</p>
            @if (Model.ShowRequestId)
            {
                <p class="muted">Request ID: <code>@Model.RequestId</code></p>
            }
        }
        <a class="button button--solid" asp-controller="Portfolio" asp-action="Index">Go to home page</a>
    </div>
</section>
